---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page has moved." noindex>
  <section class="section">
    <div class="wrap">
      <h1>We couldn’t find that page</h1>
      <p class="lede">Our website has been rebuilt, so some old links have moved. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/wardrobes/">Wardrobes</a>
        <a class="btn btn--ghost" href="/our-work/">Our work</a>
        <a class="btn btn--ghost" href="/contact/">Book a free measure</a>
      </div>
    </div>
  </section>
</Base>
