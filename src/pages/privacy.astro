---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---
<Base title="Privacy Policy" description="How Just Wardrobes & Storage handles your personal information.">
  <section class="section">
    <div class="wrap prose">
      <h1>Privacy policy</h1>
      <p>{site.name} collects the details you give us (such as your name, phone, email, suburb and project details) so we can respond to your enquiry, measure, quote and install your project.</p>
      <p>Enquiries sent through this website are stored in our customer management system. We don’t sell or share your details with anyone except where needed to deliver your job or where the law requires it.</p>
      <p>This site uses Google Tag Manager and analytics cookies to understand how people use it. You can block cookies in your browser settings.</p>
      <p>To see, correct or delete the information we hold about you, contact us on <a href={site.phoneHref}>{site.phone}</a> or <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
<style>.prose h1 { font-size: var(--step-3); }</style>
