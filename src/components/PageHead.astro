---
// Inner page header: title and intro on the left, a dimensioned photo on the right.
import Dimensioned from './Dimensioned.astro';
interface Props { title: string; intro: string; photo?: string; alt?: string; height?: string; width?: string; }
const { title, intro, photo, alt = '', height, width } = Astro.props;
---
<section class="ph">
  <div class="wrap ph__inner">
    <div class="ph__text">
      <h1 class="bar">{title}</h1>
      <p class="lede">{intro}</p>
      <slot />
    </div>
    {photo && (
      <div class="ph__photo">
        <Dimensioned src={photo} alt={alt} height={height} width={width} ratio="5 / 4" eager />
      </div>
    )}
  </div>
</section>

<style>
  .ph { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--line); }
  .ph__inner { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .ph__inner { grid-template-columns: 1fr 1.05fr; gap: 4rem; } }
  .ph h1 { font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem); }
</style>
