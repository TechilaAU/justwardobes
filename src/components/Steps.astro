---
import { steps } from '../data/content';
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="steps__n num" aria-hidden="true">{i + 1}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; counter-reset: s; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, 1fr); gap: 0; } .steps li { padding-right: 2rem; } .steps li + li { padding-left: 2rem; border-left: 1px solid var(--line); } }
  .steps__n { display: block; font-size: 2.75rem; font-family: var(--display); font-weight: 600; color: var(--cyan); line-height: 1; margin-bottom: 1rem; }
  .steps p { color: var(--graphite-2); margin: 0; font-size: 0.98rem; }
</style>
