---
// The Just Wardrobes & Storage logo (supplied artwork). logo-white.png is the
// same file with the black lettering switched to white for dark backgrounds.
interface Props { inverse?: boolean; }
const { inverse = false } = Astro.props;
---
<img
  class="logo"
  src={inverse ? '/logo-white.png' : '/logo.png'}
  alt="Just Wardrobes & Storage"
  width="700"
  height="132"
/>

<style>
  .logo { display: block; height: 3.1rem; width: auto; }
  @media (max-width: 480px) { .logo { height: 2.3rem; } }
</style>
